# Cloud Run source uploads must never include repository metadata, local runner state, or
# user-generated deliverables. Keep the application exclusions aligned with .gitignore.
.gcloudignore
.git
.git/
.gitignore
#!include:.gitignore

# Runner-local state and user-owned artifacts are intentionally outside the deployable app.
.claude/
.agents/skills/weekly-call/
.agents/skills/weekly-update/
tools/client-updates/
output/
docs/specs/

# The S260 synthetic adapters can enter only the isolated rehearsal compile.
tests/browser/fixtures/s260-compiled-mail.ts
tests/browser/fixtures/s260-compiled-mail-worker.ts
tests/browser/fixtures/s260-compiled-source-preview.ts
tests/browser/fixtures/s271-compiled-stand-in.ts

# The dedicated scanner has its own exact-file build context and service image.
infra/publication-scanner/
