{
  "quality": [
    ["run", "format:check"],
    ["run", "lint"],
    ["run", "typecheck"]
  ],
  "unit": [["test"]],
  "unit-1": [["test", "--", "--shard=1/2"]],
  "unit-2": [["test", "--", "--shard=2/2"]],
  "firestore": [["run", "test:firestore"]],
  "policy-build": [
    ["run", "verify:dependencies"],
    ["run", "verify:router-boundary"],
    ["run", "verify:falsification"],
    ["run", "verify:context-freshness"],
    ["run", "verify:active-doc-paths"],
    ["run", "verify:spec-traceability"],
    ["run", "verify:copy-voice"],
    ["run", "verify:redaction"],
    ["run", "verify:help-coverage"],
    ["run", "verify:help-controls"],
    ["run", "verify:help-screenshots"],
    ["run", "verify:help-content"],
    ["run", "check:budget-guard"],
    ["run", "build"]
  ],
  "e2e": [
    ["run", "verify:help-rendered"],
    ["run", "test:e2e", "--", "--firestore"]
  ],
  "e2e-core": [["run", "test:e2e:core"]],
  "renewal-journey": [["run", "smoke:renewal-novdec-journey"]]
}
